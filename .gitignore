# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Editor settings
.vscode/

# Separate repository (fork of brilliant-hq/pequalnp-proofs); has its own git history
pequalnp-proofs/

# Vendored python-sat build used by the search scripts (recreate with: pip install python-sat --target .scratch-sat)
.scratch-sat/*
!.scratch-sat/search_524.py
!.scratch-sat/L_meta_524_upper.lean

# Working logs; finished results live in sat-search/results/
.research/
*.log
*.jsonl
!sat-search/results/*.log
sat-search/STOP
sat-search/STOP_FILLER
!sat-search/results/*.jsonl
!sat-search/results/**/*.jsonl
# New run output in logs/ stays local (logs already tracked stay tracked; use git add -f to keep one)
sat-search/logs/**/*.out
sat-search/logs/**/*.err
sat-search/logs/16102-proof-shards/

# Native build output
sat-search/native/*.exe
sat-search/native/*.pdb
sat-search/native/*.obj
sat-search/native/*.ilk

# External baseline tools (cloned; exact commits recorded in sat-search/baselines/VERSIONS.md)
external/
